# syntax=docker/dockerfile:1
#
# FULL image — the slim image plus the headless browser (--dynamic) and the
# external recon binaries (katana, httpx, gau, retire, semgrep). This is LARGE
# (~1.5 GB+) and slow to build; most users want the plain `Dockerfile`. Use this
# only when you need --dynamic / --katana / --gau / --httpx-probe / --retire /
# --semgrep without installing anything on the host.
#
#   docker build -f Dockerfile.full -t js-extractor:full .
#   docker run --rm -v "$PWD/out:/work" js-extractor:full https://example.com \
#       --all-analysis --dynamic --katana --gau --httpx-probe --retire --semgrep --report

# ── Stage 1: compile the Go tools, keep the toolchain out of the final image ──
FROM golang:1.22-bookworm AS gobuild
ENV GOBIN=/out
RUN mkdir -p /out \
    && go install github.com/projectdiscovery/katana/cmd/katana@latest \
    && go install github.com/projectdiscovery/httpx/cmd/httpx@latest \
    && go install github.com/lc/gau/v2/cmd/gau@latest

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.12-slim

LABEL org.opencontainers.image.title="js-extractor-pro (full)" \
      org.opencontainers.image.description="js-extractor with headless browser and external recon tools bundled." \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Node (for retire.js) + CA certs. Playwright pulls its own browser OS deps below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm ca-certificates \
    && npm install -g retire \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# Go recon binaries from stage 1.
COPY --from=gobuild /out/ /usr/local/bin/

WORKDIR /src
COPY pyproject.toml README.md ./
COPY js_extractor ./js_extractor
# Package + semgrep + Playwright, then the Chromium build and its OS libraries.
RUN pip install . semgrep playwright \
    && playwright install --with-deps chromium \
    && mkdir -p /work && chmod 777 /work

WORKDIR /work
ENTRYPOINT ["js-extractor"]
CMD ["--help"]
